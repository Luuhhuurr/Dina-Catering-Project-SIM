# Salin file ini menjadi .env lalu sesuaikan bila perlu.
# docker compose sudah memakai nilai bawaan, jadi .env sifatnya opsional.

# Database PostgreSQL
POSTGRES_USER=dina
POSTGRES_PASSWORD=dina
POSTGRES_DB=dinacatering

# Kunci penanda tangan cookie session. WAJIB diganti untuk pemakaian nyata.
SESSION_SECRET=ganti-secret-ini-sebelum-dipakai-produksi

# Password akun admin (seed data awal)
ADMIN_PASSWORD=admin123

# Isi data awal bila database masih kosong
SEED_ON_BOOT=true

# Port aplikasi
PORT=8080

# Dipakai bila aplikasi dijalankan langsung di luar docker compose
DATABASE_URL=postgres://dina:dina@localhost:5432/dinacatering?sslmode=disable
